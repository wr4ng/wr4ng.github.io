$primary-background: #1f1d27;
$text-color: #c9d1d9;
$link-color: #aa95f5;
$code-background: #282a36;

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
 }

html, body {
  height: 100%;
}

body {
  display: flex;
  flex-direction: column;
}

footer {
  margin-top: auto;
  flex-shrink: 0;
  padding: 20px;
  text-align: center;
}

html {
    overflow-y: scroll;
    height: 100%;
    font: 100%/1.5 sans-serif;
    font-family: "Roboto";
    word-wrap: break-word;
    margin: 0 auto;
    padding: 1.5em;
    padding-bottom: 0;
    background-color: $primary-background;
    color: $text-color;
 }

@media (min-width: 768px) {
    html {
        font-size: 125%;
        max-width: 42em;
 } }

h1, h2, h3, h4 {
    margin: 2rem 0 0 0;
    line-height: 1.25;
 }

a {
    color: $link-color;
    text-decoration: none;
 }
a:hover, a:focus, a:active {
    text-decoration: underline;
 }

p {
    margin-top: 0.5em;
    margin-bottom: 1em;
    line-height: 1.5;
 }

ol, ul {
    margin: 1em;
    margin-top: 0.5em;
 }
ol li ol, ol li ul, ul li ol, ul li ul {
    margin: 0 2em;
 }
ol li p, ul li p {
    margin: 0;
 }

dl {
    font-family: monospace, monospace;
 }
dl dt {
    font-weight: bold;
 }
dl dd {
    margin: -1em 0 1em 1em;
 }

img {
    max-width: 100%;
    display: block;
    border-radius: 8px;
 }

blockquote {
    padding-left: 1em;
    font-style: italic;
    border-left: solid 1px #fa6432;
 }

table {
    font-size: 1rem;
    text-align: left;
    caption-side: bottom;
    margin-bottom: 2em;
 }

table * {
    border: none;
 }

table thead, table tr {
    display: table;
    table-layout: fixed;
    width: 100%;
 }

table tr:nth-child(even) {
    background-color: rgba(200, 200, 200, 0.2);
 }

table tbody {
    display: block;
    max-height: 70vh;
    overflow-y: auto;
 }

table td, table th {
    padding: 0.25em;
 }

table, .highlight > pre, pre.example {
    max-height: 70vh;
    margin: 1em 0;
    padding: 1em;
    overflow: auto;
    font-size: 0.85rem;
    font-family: monospace, monospace;
    border: 1px dashed rgba(250, 100, 50, 0.5);
}

.title {
    font-size: 2.5em;
    margin-bottom: 0;
}

.subtitle {
    font-weight: normal;
    font-size: 0.75em;
    color: #666;
}

.tags {
    margin-top: -1.5rem;
    padding-bottom: 1.5em;
}
.tags li {
    display: inline;
    margin-right: 0.5em;
}

figure {
    margin: 1em 0;
}
figure figcaption {
    font-family: monospace, monospace;
    font-size: 0.75em;
    text-align: center;
    color: grey;
}

.footnote-definition sup {
    margin-left: -1.5em;
    float: left;
}

.footnote-definition .footnote-body {
    margin: 1em 0;
    padding: 0 1em;
    border: 1px dashed rgba(250, 100, 50, 0.3);
    background-color: rgba(200, 200, 200, 0.2);
}
.footnote-definition .footnote-body p:only-child {
    margin: 0.2em 0;
}

header a + a {
    font-weight: bold;
    margin-left: 1rem;
}


.post-date {
    font-family: monospace, monospace;
    vertical-align: middle;
    padding-right: 2rem;
    margin: 0;
}

.zola-anchor {
  margin-left: 8px;
}

p code {
  font-weight: bold;
  font-size: 0.9em;
}
li code {
  font-weight: bold;
  font-size: 0.9em;
}

code {
  padding: 2px 5px;
  color: #f8f8f2;
  font-family: "JetBrains Mono", monospace;
  font-style: normal;
}

pre code {
  font-weight: normal;
  display: block;
  padding: 20px;
  white-space: pre-wrap;
  font-size: 14px;
  overflow-x: auto;
  text-wrap: nowrap;
  background-color: $code-background;
}


pre code, pre {
  border-radius: 8px;
}

code {
  border-radius: 4px;
}

header nav {
    display: flex;
    align-items: center;
}

header nav .logo img {
    height: 28px;
    width: auto;
    display: block;
    padding: 0;
    margin: 0;
}

header nav .logo {
    display: flex;
    align-items: center;
}

/* Layout */
#reading-progress {
    position: fixed;
    width: 100%;
    height: 5px;
    z-index: 9999;
    top: 0;
    left: 0;
}

#reading-progress-fill {
    height: 3px;
	border-radius: 3px;
    width: 0;
	/* Theme */
    -webkit-transition: width 100ms ease;
    -o-transition: width 100ms ease;
    transition: width 100ms ease;
    background-color: $link-color;
}

/* Copy button styling */
.copy-button {
  background-color: #1c1e26;
  color: $text-color;
  border: none;
  border-radius: 5px;
  font-size: 0.8rem;
  font-weight: bold;
  font-family: "JetBrains Mono", monospace;
  padding: 0.3em 0.6em;
  cursor: pointer;
  z-index: 1;
}

.copy-button:hover {
  background-color: #393c4d;
}

.footnote-reference {
  font-weight: bold;
}

// Scrollbar
pre {
  scrollbar-color: $link-color $code-background;
  overflow-x: auto;
}
